  {                                                                                        
    "$schema": "https://json.schemastore.org/nest-cli",                                    
    "collection": "@nestjs/schematics",                                                    
    "sourceRoot": "src",                                                                   
    "compilerOptions": {                                                                   
      "deleteOutDir": false,                  
      "assets": [                         
        {
          "include": "templates/**/*",                                                     
          "outDir": "dist"
        },                                                                                 
        {
          "include": "**/*.txt",
          "outDir": "dist"
        },
        {
          "include": "**/*.md",
          "outDir": "dist"
        }
      ],
      "watchAssets": true                     
    }                                     
  }