# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/service_marketplace?schema=public"

# -----------------------------------------------------------------------------
# Authentication and initial admin account
# -----------------------------------------------------------------------------
# Use a long, cryptographically random value outside local development.
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRATION_TIME="15m"
JWT_REFRESH_EXPIRATION_TIME="30d"

# The startup seeder creates this account when it does not already exist.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace_with_a_strong_admin_password"

# Google sign-in credentials.
GOOGLE_CLIENT_ID="replace_with_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="replace_with_google_oauth_client_secret"

# -----------------------------------------------------------------------------
# Application URLs and branding
# -----------------------------------------------------------------------------
APP_NAME="Pavodah"
APP_URL="http://localhost:3001"
WEBSITE_URL="http://localhost:3001"
SUPPORT_EMAIL="support@example.com"

# Comma-separated web origins, with no path or trailing slash.
CORS_ORIGINS="http://localhost:3001"

# -----------------------------------------------------------------------------
# Email
# EMAIL_PROVIDER: AWS | RESEND | ZEPTO
# Only the credentials for the selected provider are required.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER="RESEND"
FROM_EMAIL="noreply@example.com"

# Resend
RESEND_API_KEY="re_replace_me"
RESEND_FROM_EMAIL="Pavodah <noreply@example.com>"

# ZeptoMail
ZEPTO_API_KEY="replace_with_zeptomail_api_key"

# AWS SES (the same AWS credentials can also be used by S3 below)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="replace_with_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="replace_with_aws_secret_access_key"

# -----------------------------------------------------------------------------
# File uploads
# FILE_UPLOAD_PROVIDER: LOCAL | SUPABASE | AWS_S3 | CLOUDINARY
# LOCAL needs no additional credentials and is suitable for local development.
# Only configure the block for the selected provider.
# -----------------------------------------------------------------------------
FILE_UPLOAD_PROVIDER="LOCAL"

# Supabase Storage
SUPABASE_URL="https://replace_me.supabase.co"
SUPABASE_KEY="replace_with_supabase_service_role_key"
SUPABASE_BUCKET_NAME="pavodah-files"

# Amazon S3 (uses AWS_REGION and AWS credentials from the email section)
AWS_S3_BUCKET_NAME="replace_with_s3_bucket_name"

# Cloudinary
# CLOUDINARY_API_SECRETE matches the variable name currently read by the API.
CLOUDINARY_CLOUD_NAME="replace_with_cloudinary_cloud_name"
CLOUDINARY_API_KEY="replace_with_cloudinary_api_key"
CLOUDINARY_API_SECRETE="replace_with_cloudinary_api_secret"

# -----------------------------------------------------------------------------
# SMS
# SMS_PROVIDER: TEST | HUBTEL | ARKESEL | AFRICASTALKING
# TEST logs messages instead of sending them and is intended for local use.
# Only the credentials for the selected provider are required.
# -----------------------------------------------------------------------------
SMS_PROVIDER="TEST"
SMS_REQUEST_TIMEOUT_MS="10000"

# Hubtel
HUBTEL_CLIENT_ID="replace_with_hubtel_client_id"
HUBTEL_CLIENT_SECRET="replace_with_hubtel_client_secret"
HUBTEL_SENDER_ID="Pavodah"

# Arkesel
ARKESEL_API_KEY="replace_with_arkesel_api_key"
ARKESEL_SENDER_ID="Pavodah"

# Africa's Talking
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY="replace_with_africastalking_api_key"
AFRICASTALKING_SENDER_ID=""
AFRICASTALKING_SANDBOX="true"
AFRICASTALKING_ENQUEUE="true"

# -----------------------------------------------------------------------------
# OpenAI-powered bot and support chat
# -----------------------------------------------------------------------------
OPEN_AI_KEY="replace_with_openai_api_key"

# -----------------------------------------------------------------------------
# Paystack hosted checkout, signed webhooks, refunds, and provider payouts
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_CALLBACK_URL="http://localhost:3001/checkout/callback"

# Keep payouts disabled until the Paystack business is approved for transfers.
PAYOUTS_ENABLED="false"
PAYOUT_RECONCILIATION_ENABLED="true"
PAYOUT_RECONCILIATION_INTERVAL_MS="900000"

# Refund recovery runs independently from provider payouts.
REFUND_RECONCILIATION_ENABLED="true"
REFUND_RECONCILIATION_INTERVAL_MS="900000"
