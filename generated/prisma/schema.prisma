generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Role {
  USER
  ADMIN
  SERVICE_PROVIDER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
  PAUSED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum UserInterestType {
  INTEREST
  SERVICE
}

enum DocumentType {
  CERTIFICATION
  LICENSE
  TRAINING_CERTIFICATE
  ID_DOCUMENT
  OTHER
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// Models
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth & Basic Info
  email                 String    @unique
  emailVerified         Boolean   @default(false)
  password              String?
  passwordResetOtp      String?
  passwordResetExpires  DateTime?
  passwordResetAttempts Int       @default(0)
  role                  Role      @default(USER)
  firstName             String?
  lastName              String?
  displayName           String?
  username              String?   @unique
  avatar                String?
  bio                   String?
  dateOfBirth           DateTime?
  timezone              String    @default("UTC")

  // Phone & Verification
  phoneNumber   String?
  countryCode   String?
  phoneVerified Boolean @default(false)

  // Social Auth
  googleId   String? @unique
  appleId    String? @unique
  facebookId String? @unique
  twitterId  String? @unique

  // Onboarding & Profile
  hasCompletedOnboarding Boolean   @default(false)
  onboardingCompletedAt  DateTime?
  profileCompleteness    Int       @default(0) // 0-100%

  // Service Provider Specific
  serviceProviderExperienceLevel ExperienceLevel?
  isServiceProviderVerified      Boolean          @default(false)
  serviceProviderVerifiedAt      DateTime?

  // Subscription
  isPremium             Boolean             @default(false)
  subscriptionStatus    SubscriptionStatus?
  subscriptionTier      String?
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?

  // Preferences
  themePreference        ThemePreference @default(SYSTEM)
  notificationsEnabled   Boolean         @default(true)
  marketingNotifications Boolean         @default(false)
  preferredLanguage      String          @default("en")
  isProfilePublic        Boolean         @default(false)
  dataAnalyticsEnabled   Boolean         @default(true)

  // Status & Activity
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  lastActiveAt DateTime   @default(now())

  // Relations
  addresses             UserAddress[]
  interests             UserInterest[]
  verificationDocuments VerificationDocument[]

  @@map("users")
}

model UserAddress {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String
  placeId          String? // Google Places ID
  addressName      String // User-friendly name like "Home", "Work"
  formattedAddress String // Full formatted address from Google Places
  latitude         Float
  longitude        Float
  city             String?
  state            String?
  country          String?
  postalCode       String?
  isPrimary        Boolean  @default(false)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_addresses")
}

model Category {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)

  // Relations
  userInterests UserInterest[]

  @@map("categories")
}

model UserInterest {
  id         String           @id @default(cuid())
  createdAt  DateTime         @default(now())
  userId     String
  categoryId String
  type       UserInterestType // INTEREST or SERVICE

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, type])
  @@map("user_interests")
}

model VerificationDocument {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  userId       String
  fileName     String // Stored file name
  originalName String // Original file name from user
  fileUrl      String // URL to access the file
  fileType     String // MIME type
  fileSize     Int // File size in bytes
  documentType DocumentType
  status       DocumentStatus @default(UPLOADED)
  reviewNotes  String? // Admin notes during review
  uploadedAt   DateTime       @default(now())
  reviewedAt   DateTime?
  reviewedBy   String? // Admin user ID who reviewed

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_documents")
}
