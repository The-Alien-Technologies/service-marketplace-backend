generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             String                 @id @default(cuid())
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  email                          String                 @unique
  emailVerified                  Boolean                @default(false)
  password                       String?
  passwordResetOtp               String?
  passwordResetExpires           DateTime?
  passwordResetAttempts          Int                    @default(0)
  role                           Role                   @default(USER)
  firstName                      String?
  lastName                       String?
  displayName                    String?
  username                       String?                @unique
  avatar                         String?
  bio                            String?
  dateOfBirth                    DateTime?
  timezone                       String                 @default("UTC")
  phoneNumber                    String?
  countryCode                    String?
  phoneVerified                  Boolean                @default(false)
  googleId                       String?                @unique
  appleId                        String?                @unique
  facebookId                     String?                @unique
  twitterId                      String?                @unique
  hasCompletedOnboarding         Boolean                @default(false)
  onboardingCompletedAt          DateTime?
  profileCompleteness            Int                    @default(0)
  serviceProviderExperienceLevel ExperienceLevel?
  isServiceProviderVerified      Boolean                @default(false)
  serviceProviderVerifiedAt      DateTime?
  isPremium                      Boolean                @default(false)
  subscriptionStatus             SubscriptionStatus?
  subscriptionTier               String?
  subscriptionStartDate          DateTime?
  subscriptionEndDate            DateTime?
  themePreference                ThemePreference        @default(SYSTEM)
  notificationsEnabled           Boolean                @default(true)
  marketingNotifications         Boolean                @default(false)
  preferredLanguage              String                 @default("en")
  isProfilePublic                Boolean                @default(false)
  dataAnalyticsEnabled           Boolean                @default(true)
  status                         UserStatus             @default(ACTIVE)
  lastLoginAt                    DateTime?
  lastActiveAt                   DateTime               @default(now())
  emailVerificationAttempts      Int                    @default(0)
  emailVerificationExpires       DateTime?
  emailVerificationOtp           String?
  emailNotificationsEnabled      Boolean                @default(true)
  smsNotificationsEnabled        Boolean                @default(false)
  providerConversations          Conversation[]         @relation("ProviderConversations")
  userConversations              Conversation[]         @relation("UserConversations")
  clientDisputes                 Dispute[]              @relation("ClientDisputes")
  providerDisputes               Dispute[]              @relation("ProviderDisputes")
  sentMessages                   Message[]              @relation("SentMessages")
  clientOrders                   Order[]                @relation("ClientOrders")
  providerOrders                 Order[]                @relation("ProviderOrders")
  quoteRequestsAsClient          QuoteRequest[]         @relation("ClientQuoteRequests")
  quoteRequestsAsProvider        QuoteRequest[]         @relation("ProviderQuoteRequests")
  clientReviews                  Review[]               @relation("ClientReviews")
  providerReviews                Review[]               @relation("ProviderReviews")
  services                       Service[]
  handledSupportConversations    SupportConversation[]  @relation("SupportAdmin")
  initiatedSupportConversations  SupportConversation[]  @relation("SupportInitiator")
  supportMessages                SupportMessage[]       @relation("SupportMessageSender")
  addresses                      UserAddress[]
  interests                      UserInterest[]
  verificationDocuments          VerificationDocument[]

  @@map("users")
}

model UserAddress {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String
  placeId          String?
  addressName      String
  formattedAddress String
  latitude         Float
  longitude        Float
  city             String?
  state            String?
  country          String?
  postalCode       String?
  isPrimary        Boolean  @default(false)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_addresses")
}

model Category {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  name             String         @unique
  description      String?
  isActive         Boolean        @default(true)
  featured         Boolean        @default(false)
  parentCategoryId String?
  imageUrl         String?
  parentCategory   Category?      @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subCategories    Category[]     @relation("CategoryHierarchy")
  services         Service[]
  userInterests    UserInterest[]

  @@map("categories")
}

model UserInterest {
  id         String           @id @default(cuid())
  createdAt  DateTime         @default(now())
  userId     String
  categoryId String
  type       UserInterestType
  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, type])
  @@map("user_interests")
}

model VerificationDocument {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  userId       String
  fileName     String
  originalName String
  fileUrl      String
  fileType     String
  fileSize     Int
  documentType DocumentType
  status       DocumentStatus @default(UPLOADED)
  reviewNotes  String?
  uploadedAt   DateTime       @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_documents")
}

model PhoneVerification {
  id          String   @id @default(cuid())
  phoneNumber String
  otpCode     String
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  expiresAt   DateTime
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("phone_verifications")
}

model Service {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  title         String
  slug          String         @unique
  overview      String
  coverImage    String?
  tags          String[]
  status        ServiceStatus  @default(DRAFT)
  providerId    String
  categoryId    String
  orders        Order[]
  quoteRequests QuoteRequest[]
  reviews       Review[]
  addons        ServiceAddon[]
  images        ServiceImage[]
  plans         ServicePlan[]
  category      Category       @relation(fields: [categoryId], references: [id])
  provider      User           @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("services")
}

model ServicePlan {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  title      String
  price      Decimal  @db.Decimal(10, 2)
  inclusions String
  isPopular  Boolean  @default(false)
  sortOrder  Int      @default(0)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_plans")
}

model ServiceAddon {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_addons")
}

model ServiceImage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  url       String
  fileName  String
  sortOrder Int      @default(0)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_images")
}

model Order {
  id             String       @id @default(cuid())
  orderNumber    String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  clientId       String
  providerId     String
  serviceId      String
  planId         String?
  planTitle      String
  planPrice      Decimal      @db.Decimal(10, 2)
  planInclusions String
  subtotal       Decimal      @db.Decimal(10, 2)
  addOnsTotal    Decimal      @default(0) @db.Decimal(10, 2)
  couponCode     String?
  couponDiscount Decimal      @default(0) @db.Decimal(10, 2)
  total          Decimal      @db.Decimal(10, 2)
  status         OrderStatus  @default(PENDING)
  dispute        Dispute?
  addOns         OrderAddOn[]
  client         User         @relation("ClientOrders", fields: [clientId], references: [id])
  provider       User         @relation("ProviderOrders", fields: [providerId], references: [id])
  service        Service      @relation(fields: [serviceId], references: [id])
  review         Review?

  @@map("orders")
}

model OrderAddOn {
  id          String  @id @default(cuid())
  orderId     String
  addonId     String?
  title       String
  description String?
  price       Decimal @db.Decimal(10, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addons")
}

model Review {
  id         String          @id @default(cuid())
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  orderId    String          @unique
  clientId   String
  providerId String
  serviceId  String
  rating     Int
  comment    String?
  response   ReviewResponse?
  client     User            @relation("ClientReviews", fields: [clientId], references: [id])
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   User            @relation("ProviderReviews", fields: [providerId], references: [id])
  service    Service         @relation(fields: [serviceId], references: [id])

  @@map("reviews")
}

model ReviewResponse {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviewId  String   @unique
  comment   String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_responses")
}

model Conversation {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  providerId String
  userId     String
  provider   User      @relation("ProviderConversations", fields: [providerId], references: [id])
  user       User      @relation("UserConversations", fields: [userId], references: [id])
  messages   Message[]

  @@unique([providerId, userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])

  @@map("messages")
}

model SupportConversation {
  id            String                    @id @default(cuid())
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  initiatorId   String
  initiatorType SupportSenderType
  adminId       String?
  status        SupportConversationStatus @default(BOT)
  closedAt      DateTime?
  adminJoinedAt DateTime?
  admin         User?                     @relation("SupportAdmin", fields: [adminId], references: [id])
  initiator     User                      @relation("SupportInitiator", fields: [initiatorId], references: [id])
  messages      SupportMessage[]

  @@map("support_conversations")
}

model SupportMessage {
  id             String              @id @default(cuid())
  createdAt      DateTime            @default(now())
  conversationId String
  senderId       String?
  senderType     SupportSenderType
  content        String
  botResponseId  String?
  isRead         Boolean             @default(false)
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?               @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("support_messages")
}

model QuoteRequest {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  clientId      String
  providerId    String
  serviceId     String?
  projectTitle  String
  description   String
  deliveryTime  String
  budget        Decimal     @db.Decimal(10, 2)
  currency      String      @default("GHS")
  attachments   String[]
  status        QuoteStatus @default(NEW)
  providerNote  String?
  declineReason String?
  client        User        @relation("ClientQuoteRequests", fields: [clientId], references: [id])
  provider      User        @relation("ProviderQuoteRequests", fields: [providerId], references: [id])
  service       Service?    @relation(fields: [serviceId], references: [id])

  @@map("quote_requests")
}

model Dispute {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  orderId     String           @unique
  clientId    String
  providerId  String
  issueType   DisputeIssueType
  description String
  priority    DisputePriority  @default(LOW)
  status      DisputeStatus    @default(OPEN)
  adminNote   String?
  resolvedAt  DateTime?
  client      User             @relation("ClientDisputes", fields: [clientId], references: [id])
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    User             @relation("ProviderDisputes", fields: [providerId], references: [id])

  @@map("disputes")
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @db.Timestamp(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamp(6)
  updatedAt             DateTime  @default(now()) @db.Timestamp(6)
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model session {
  id        String   @id
  expiresAt DateTime @db.Timestamp(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @default(now()) @db.Timestamp(6)
  account       account[]
  session       session[]
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamp(6)
  createdAt  DateTime? @db.Timestamp(6)
  updatedAt  DateTime? @db.Timestamp(6)
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Role {
  USER
  ADMIN
  SERVICE_PROVIDER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
  PAUSED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum UserInterestType {
  INTEREST
  SERVICE
}

enum DocumentType {
  CERTIFICATION
  LICENSE
  TRAINING_CERTIFICATE
  ID_DOCUMENT
  OTHER
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  AWAITING
  IN_PROGRESS
  COMPLETED
  DECLINED
  REFUNDED
}

enum QuoteStatus {
  NEW
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum DisputeIssueType {
  LATE_DELIVERY
  NON_DELIVERY
  QUALITY_ISSUE
  PAYMENT_DISPUTE
  MISCOMMUNICATION
  OTHER
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
}

enum SupportConversationStatus {
  BOT
  AWAITING_FOR_ADMIN
  ACTIVE_WITH_ADMIN
  CLOSED
}

enum SupportSenderType {
  USER
  SERVICE_PROVIDER
  ADMIN
  BOT
}
